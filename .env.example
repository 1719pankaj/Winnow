# Winnow Environment Variables
# Copy this file to .env and fill in your API keys.

# ==============================================================================
# Search Providers (At least one search key is required)
# ==============================================================================
SERPER_KEY=
TRAVITY_KEY=
SERPAPI_KEY=
EXA_AI_KEY=
OCTOPARSE_KEY=

# ==============================================================================
# Inference Providers (Groq, Cerebras, Gemini, NIM, OpenRouter)
# ==============================================================================
GROQ_KEY=
CEREBRAS_KEY=
GEMINI_AI_STUDIO_KEY=
NVIDIA_NIM_API_KEY=
OPEN_ROUTER_API_KEY=

# ==============================================================================
# Content Extractors (Optional / Fallback)
# ==============================================================================
FIRECRAWL_API_KEY=
JINA_API_KEY=

# ==============================================================================
# Database (Optional - Defaults to local file:winnow.db SQLite if omitted)
# For production deployment, connect a Turso database (https://turso.tech)
# ==============================================================================
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ==============================================================================
# GitHub Issue Reporting (Automated user bug & trace reporting)
# Create a GitHub PAT with `repo` or `Issues: Read & write` scope
# ==============================================================================
GITHUB_TOKEN=
GITHUB_REPO=1719pankaj/Winnow

